{
    "name": "new_world_org/medication_history",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "darkaonline/l5-swagger": "^11.2",
        "fyui001/courage": "^2.0",
        "guzzlehttp/guzzle": "^7.9",
        "jeroennoten/laravel-adminlte": "^3.16",
        "kyslik/column-sortable": "dev-master",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "team-reflex/discord-php": "^10.68"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "doctrine/dbal": "^4.5",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4",
        "spatie/laravel-ignition": "^2.12",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Domain\\": "domain/",
            "Infra\\": "infra/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Libs\\": "database/libs/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
